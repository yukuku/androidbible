[{"interactions":["clickable","focusable"],"center":"[360,80]","resource-id":"toolbar","key":3506402},{"content-desc":"Kembali ke atas","interactions":["clickable","focusable"],"center":"[56,104]","key":3506402},{"text":"KJ 1 ▾","center":"[164,103]","key":3506402},{"content-desc":"Cari","interactions":["clickable","focusable"],"center":"[584,104]","resource-id":"menuSearch","key":3506402},{"content-desc":"Opsi lainnya","interactions":["clickable","focusable","long-clickable"],"center":"[680,104]","key":3506402},{"interactions":["clickable","focusable"],"center":"[480,104]","key":3506402},{"interactions":["focusable"],"center":"[360,720]","key":3506402},{"content-desc":"Audio \u0026 video","center":"[480,104]","key":3506402},{"interactions":["scrollable"],"center":"[360,720]","bounds":"[0,160][720,1280]","key":3506402},{"text":"1","center":"[45,234]","key":3506402},{"text":"Haleluya, Pujilah","center":"[384,234]","key":3506402},{"text":"1\u003dF 4/4","center":"[360,295]","key":3506402},{"text":"Ref.:","center":"[119,359]","key":3506402},{"text":"Haleluya! Pujilah Allah Yang Agung, Mahaesa!","center":"[403,424]","key":3506402},{"text":"Dalam Kristus kita kenal Allah Yang Hidup, Bapa kekal!","center":"[403,522]","key":3506402},{"text":"1","center":"[70,656]","key":3506402},{"text":"Langit, buana semesta patut memuji kuasa-Nya,","center":"[385,684]","key":3506402},{"text":"kar\u0027na berkat-Nya tak henti, limpah kasih-Nya tak terperi.","center":"[385,782]","key":3506402},{"text":"2","center":"[70,916]","key":3506402},{"text":"Wahai dunia, soraklah! Angkat suaramu, nyanyilah!","center":"[385,944]","key":3506402},{"text":"Tabuhlah tifa dan gendang, iringi puji dalam tembang!","center":"[385,1042]","key":3506402},{"text":"(C) YAYASAN MUSIK GEREJA DI INDONESIA (YAMUGER)","center":"[360,1183]","key":3506402},{"text":"Kirim perbaikan","center":"[127,1247]","key":3506402}]