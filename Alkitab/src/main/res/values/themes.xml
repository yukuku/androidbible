<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Alkitab.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Alkitab</item>
    </style>

	<style name="Theme.Base.Alkitab" parent="Theme.MaterialComponents.NoActionBar.Bridge">
        <item name="viewInflaterClass">yuku.alkitab.base.util.TypographyViewInflater</item>
		<item name="android:colorPrimary">@color/primary</item>
		<item name="colorPrimary">@color/primary</item>
		<item name="android:colorPrimaryDark">@color/primary_dark</item>
		<item name="colorPrimaryDark">@color/primary_dark</item>
		<item name="android:colorAccent">@color/accent</item>
		<item name="colorAccent">@color/accent</item>
		<item name="android:windowDrawsSystemBarBackgrounds">true</item>
		<item name="android:statusBarColor">@android:color/transparent</item>
		<item name="android:navigationBarColor">#000</item>
		<item name="android:textColorLink">@color/accent</item>
		<item name="android:windowBackground">@color/window</item>
		<item name="actionModeStyle">@style/SmallerTitleActionModeStyle</item>
		<item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
		<item name="toolbarStyle">@style/ToolbarStyle</item>
        <item name="tabStyle">@style/Widget.Alkitab.TabLayout</item>
		<item name="windowActionModeOverlay">true</item>
        <item name="android:textAppearanceSmall">@style/TextAppearance.Alkitab.Supporting</item>
        <item name="android:textAppearanceMedium">@style/TextAppearance.Alkitab.Primary</item>
        <item name="android:textAppearanceLarge">@style/TextAppearance.Alkitab.Title</item>
        <item name="textAppearanceBody1">@style/TextAppearance.Alkitab.Primary</item>
        <item name="textAppearanceBody2">@style/TextAppearance.Alkitab.Supporting</item>
        <item name="textAppearanceCaption">@style/TextAppearance.Alkitab.Caption</item>
        <item name="buttonStyle">@style/Widget.Alkitab.Button</item>
        <item name="android:textAppearanceButton">@style/TextAppearance.Alkitab.Label</item>
        <item name="textAppearanceButton">@style/TextAppearance.Alkitab.Label</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.Alkitab.Title</item>

	</style>

    <style name="Widget.Alkitab.TabLayout" parent="Widget.Design.TabLayout">
        <item name="tabTextAppearance">@style/TextAppearance.Alkitab.Tab</item>
    </style>

	<style name="SmallerTitleActionModeStyle" parent="Widget.AppCompat.ActionMode">
		<item name="titleTextStyle">@style/SmallerActionModeTitleTextAppearance</item>
        <item name="subtitleTextStyle">@style/TextAppearance.Alkitab.Supporting</item>
	</style>

	<style name="SmallerActionModeTitleTextAppearance" parent="TextAppearance.Alkitab.Emphasis" />

	<style name="ToolbarStyle" parent="Widget.AppCompat.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.Alkitab.Title</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.Alkitab.Supporting</item>
		<item name="contentInsetStart">?actionBarSize</item>
		<item name="contentInsetStartWithNavigation">?actionBarSize</item>
		<item name="titleMarginStart">0dp</item>
	</style>

	<!-- The app theme is dark-based, so its colorControlNormal is 70% white. Toolbars sit on the
		dark primary colour and need their navigation, overflow and SearchView icons fully white.
		The framework attribute covers android.widget.SearchView. -->
	<style name="ThemeOverlay.Alkitab.Toolbar" parent="">
		<item name="colorControlNormal">@android:color/white</item>
		<item name="android:colorControlNormal">@android:color/white</item>
	</style>

	<style name="Theme.Alkitab.Transparent">
		<item name="android:windowTranslucentNavigation">true</item>
		<item name="android:windowTranslucentStatus">true</item>
		<item name="android:windowBackground">@android:color/transparent</item>
		<item name="android:colorBackgroundCacheHint">@null</item>
		<item name="android:windowIsTranslucent">true</item>
		<item name="android:windowAnimationStyle">@android:style/Animation</item>
		<item name="android:windowNoTitle">true</item>
		<item name="android:windowContentOverlay">@null</item>
		<item name="android:windowFrame">@null</item>
		<item name="android:windowActionBar">false</item>
		<item name="windowActionBar">false</item>
	</style>

	<style name="Theme.PopupActivity" parent="Theme.Alkitab">
		<item name="android:windowTranslucentNavigation">true</item>
		<item name="android:windowTranslucentStatus">true</item>
		<item name="android:windowBackground">@android:color/transparent</item>
		<item name="android:colorBackgroundCacheHint">@null</item>
		<item name="android:windowIsTranslucent">true</item>
		<item name="android:windowAnimationStyle">@android:style/Animation</item>
		<item name="android:windowNoTitle">true</item>
		<item name="android:windowContentOverlay">@null</item>
		<item name="android:windowFrame">@null</item>
		<item name="android:windowActionBar">false</item>
		<item name="windowActionBar">false</item>
	</style>
</resources>
