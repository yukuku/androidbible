<?xml version="1.0" encoding="utf-8"?><!--
	Action view used by the audio menu item while the service is preparing a
	chapter. Padded so the indicator sits in the same visual slot as the menu
	icon it replaces; without padding the small-title style would collapse to
	~12dp and float oddly inside the action button.
-->
<ProgressBar xmlns:android="http://schemas.android.com/apk/res/android"
	style="?android:attr/progressBarStyleSmall"
	android:layout_width="wrap_content"
	android:layout_height="match_parent"
	android:padding="14dp" />
